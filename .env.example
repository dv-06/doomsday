# Doomsday Watch — example environment file
# Copy to .env for local use (never commit .env) or set these as GitHub Actions
# repository secrets. Everything here is optional; the monitor runs without any
# credentials and simply sends no alerts.

# --- Paths (optional) -------------------------------------------------------
# DOOMSDAY_CONFIG=config/monitor.json
# DOOMSDAY_DATA=data

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then find your chat id with @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy.sh (free push, no account needed) ---------------------------------
# Pick an unguessable topic, e.g. doomsday-bengaluru-7f3c9a. Subscribe to the
# same topic in the ntfy Android/iOS app or at https://ntfy.sh/<topic>.
NTFY_TOPIC=

# --- Generic webhook --------------------------------------------------------
# Receives POST {"title": ..., "message": ..., "events": [...]}. Useful for
# Discord/Slack relays, Home Assistant or your own endpoint.
NOTIFY_WEBHOOK_URL=

# Public dashboard URL included in alert messages (optional).
DASHBOARD_URL=

# --- Optional FastAPI backend (local only) ----------------------------------
# Bearer token required by POST /api/run. Leave empty to disable that endpoint.
ADMIN_TOKEN=
CORS_ORIGINS=*
